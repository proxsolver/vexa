{
  "permissions": {
    "allow": [
      "Bash(python3 tests3/*)",
      "Bash(python3 -m pytest*)",
      "Bash(make test*)",
      "Bash(make lint*)",
      "Bash(make fmt*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)",
      "Bash(docker ps*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(helm lint*)",
      "Bash(helm template*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(pip list*)",
      "Bash(pip show*)",
      "Bash(npm list*)",
      "Bash(npm run lint*)",
      "Bash(find *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(which *)",
      "Bash(echo *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(drop database*)",
      "Bash(git push --force*)",
      "Bash(docker system prune*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'File modified: $CLAUDE_FILE_PATH'"
          }
        ]
      }
    ]
  }
}
